# ============================================
# متغيرات البيئة - منصة كلية هندسة المعلوماتية
# انسخ هذا الملف إلى .env وعدّل القيم
# ============================================

# إعدادات Django الأساسية
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# قاعدة البيانات PostgreSQL
# استخدم USE_SQLITE=true للتطوير السريع بدون PostgreSQL
USE_SQLITE=false
DB_NAME=informatics_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600
DB_CONNECT_TIMEOUT=10

# Redis (للمهام الخلفية وتحديد المعدل)
REDIS_URL=redis://localhost:6379/0

# Hugging Face Inference API — up to 4 keys with automatic quota rotation
# Option A: comma-separated list
# HF_TOKENS=hf_key_one,hf_key_two,hf_key_three,hf_key_four
# Option B: primary + numbered extras (preferred for local .env)
HF_TOKEN=hf_your-huggingface-token-here
HF_TOKEN_2=
HF_TOKEN_3=
HF_TOKEN_4=
# meta-llama/Meta-Llama-3-8B-Instruct (accept model license on huggingface.co first)
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# Inference provider ("auto" picks the best available; e.g. hf-inference, novita, together)
HF_PROVIDER=auto
# Fast fallback models when the primary is busy/loading (Llama-3.2-3B is most available)
HF_FALLBACK_MODELS=meta-llama/Llama-3.2-3B-Instruct,mistralai/Mistral-7B-Instruct-v0.3
HF_TIMEOUT=120

# Visual AI illustrations (Pollinations public image endpoint)
AI_IMAGE_PROVIDER=pollinations
AI_IMAGE_BASE_URL=https://image.pollinations.ai/prompt
AI_IMAGE_WIDTH=1024
AI_IMAGE_HEIGHT=768

# JWT - رموز المصادقة
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# رفع الملفات
MAX_UPLOAD_SIZE_MB=20
GUEST_FILE_EXPIRY_HOURS=24

# تحديد معدل طلبات الذكاء الاصطناعي (في الساعة)
AI_RATE_LIMIT_STUDENT=20
AI_RATE_LIMIT_GUEST=5

# اللغة الافتراضية
DEFAULT_LANGUAGE=ar
